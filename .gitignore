# Theme/service-worker backups written by deploy/install-theme.sh on the server.
# They are never in the repository, and a stray copy must not be committed
# either: /root/.hydro/static is served by Caddy, so a *.bak-* file next to a
# real asset is a public download.
*.bak-*

# Agent/editor session state. The operational knowledge distilled from these
# lives in docs/ops-knowledge.md; the raw session dirs must not be committed.
.codely/
.codely-cli/
.zcode/

# Broadcast bot credential file (read-only MongoDB URI). Only the
# mongo_uri.txt.example template belongs in the repository.
plugin-dfacm-broadcast/mongo_uri.txt

# Contest calendar runtime cache (platform auto-fetch, written by auto.cjs
# on the server and by stray test-refresh races locally; never shipped).
plugin-dfacm-calendar/auto-cache.json
plugin-dfacm-calendar/auto-cache-*.json
plugin-dfacm-calendar/clist-cache.json
plugin-dfacm-calendar/ai-cache.json
plugin-dfacm-calendar/*-cache*.tmp

# Taxonomy repair sessions: bulky data snapshots regenerated from the OJ
# (statement/testdata copies and full verification dumps). The pipeline
# scripts, checkers, oracle/reference sources, per-batch manifests and
# REPORT.md are committed; these large regenerable dumps are not.
scripts/taxonomy/repairs/2026-10-22/local-tests.json
scripts/taxonomy/repairs/2026-10-22/local-tests.json.gz
scripts/taxonomy/repairs/2026-10-22/ordered-statements.json.gz
scripts/taxonomy/repairs/2026-10-22/ordered-statements.manifest.json
scripts/taxonomy/repairs/2026-10-22/ordered-sample-recovery.json
scripts/taxonomy/repairs/training-6abf5251-2026-10-22/verification-manifest.json
scripts/taxonomy/repairs/xcpc-2026-10-22/verification-manifest.json

