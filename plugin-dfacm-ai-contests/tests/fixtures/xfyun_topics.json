{"data": [{"industry": "语音技术", "status": "2", "order": 710, "hot": null, "semiFinalEnd_basic_problem": "1999-09-09", "prelimEnd_basic_problem": "2026-09-24", "contest_name": "822", "bonus_basic_problem": "1", "registerBegin_basic_problem": "2026-08-14", "registerEnd_basic_problem": "2026-09-24", "cover_basic_problem": "2930", "finalBegin_basic_problem": "2026-10-24", "type_basic_problem": "algorithem", "prelimBegin_basic_problem": "2026-08-14", "desc_basic_problem": "音频通信系统，如视频会议软件、语音通信软件、智能手机和固定电话，已被全球几乎所有人广泛使用，成为工作与个人生活中不可或缺的工具。尽管迄今为止已投入大量的研究，如于降噪、解混响的学术研究与工业落地，但要实现一套堪比面对面交流的系统 —— 尤其是在主流设备上实现这一目标，仍有很长的路要走。", "name_basic_problem": "语音质量修复挑战赛 赛季2", "contest_flag": "VoiceFixer", "finalEnd_basic_problem": "2026-10-24", "sponsorName_basic_problem": "声网", "external_link": null, "team_count": "703", "publish_time": "2026-08-13 16:43:31", "update_time": "2026-10-24 10:58:20", "create_time": null, "ladder_tournament": null, "roadshow_replay_status": "3"}, {"industry": "多模态技术", "status": "2", "order": 300, "hot": null, "semiFinalEnd_basic_problem": "1999-09-09", "prelimEnd_basic_problem": "2027-01-31", "contest_name": "846", "bonus_basic_problem": "0", "registerBegin_basic_problem": "2026-09-21", "registerEnd_basic_problem": "2027-01-31", "cover_basic_problem": "2954", "finalBegin_basic_problem": "1999-09-09", "type_basic_problem": "train", "prelimBegin_basic_problem": "2026-09-21", "desc_basic_problem": "公式是科学、工程、金融等领域文档中的核心内容，它们以紧凑、精确的方式表达复杂的数学关系、物理定律或统计模型。然而，这些公式通常以图像形式嵌入在PDF文档、扫描件或网页中，难以被机器直接理解和处理。传统的OCR技术可以识别公式中的字符，但无法理解其结构和语义（例如，哪个是上标、哪个是下标、哪个是分母、哪个是变量），更不用说利用这些公式进行计算或回答基于公式的复杂问题。\n随着大模型和计算机视觉技术的进步，我们现在有机会实现对文档中公式的深度解析和智能问答。这项技术将极大地解放科研人员和工程师，使他们能够更高效地从海量文献中提取知识、验证理论、进行数据分析，并在智能教育、科学计算、专利分析等领域具有革命性的应用潜力。", "name_basic_problem": "文档公式解析与智能问答练手赛", "contest_flag": "train-Parse-QA", "finalEnd_basic_problem": "1999-09-09", "sponsorName_basic_problem": "科大讯飞xDatawhale", "external_link": null, "team_count": "7", "publish_time": "2026-09-20 18:33:42", "update_time": "2026-09-21 09:12:42", "create_time": null, "ladder_tournament": null, "roadshow_replay_status": null}, {"industry": "数据挖掘", "status": "0", "order": 300, "hot": null, "semiFinalEnd_basic_problem": "1999-09-09", "prelimEnd_basic_problem": "2027-01-31", "contest_name": "742", "bonus_basic_problem": "0", "registerBegin_basic_problem": "2026-05-15", "registerEnd_basic_problem": "2027-01-31", "cover_basic_problem": "2846", "finalBegin_basic_problem": "1999-09-09", "type_basic_problem": "train", "prelimBegin_basic_problem": "2026-05-15", "desc_basic_problem": "根据行业规范公告企业信息及研究机构测算，2022年全国锂离子电池产量达750GWh，行业总产值突破1.2万亿元。锂电池凭借重量轻、高比能量、性能稳定等特点，越来越受到市场青睐，近些年一直保持着快速增长的态势。但在锂电池日常使用的过程中，电池本身的热量与环境的高温叠加，将严重影响电池的寿命。 \n锂离子电池材料的主要生产设备是电炉，研究烧结过程的数字化建模，通过电炉空间温度推测产品内部温度，设计烧结过程的温度场和浓度场的最优控制律，搭建产品制备过程运行平台，有望最终实现该过程的效率提升和协同优化，达到提高产品一致性，降低生产能耗的目标。", "name_basic_problem": "锂离子电池生产参数调控及生产温度预测练手赛", "contest_flag": "Train-lithium-ion-battery", "finalEnd_basic_problem": "1999-09-09", "sponsorName_basic_problem": "北京科技大学", "external_link": null, "team_count": "4", "publish_time": "2026-04-22 14:36:03", "update_time": "2026-06-08 19:34:13", "create_time": null, "ladder_tournament": null, "roadshow_replay_status": null}]}