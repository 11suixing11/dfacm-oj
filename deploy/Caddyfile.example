# For more information, refer to caddy v2 documentation.

# Cloudflare (free plan) fronts this site. Trust only CF's edge IPs when
# deriving the client IP (used by access logs' client_ip field). Upstream
# X-Forwarded-For is pinned per-path in the @fromcf/direct handles below, so
# client-supplied forwarding headers never reach Hydro either way. Ranges from
# https://www.cloudflare.com/ips/ (they rarely move; re-verify when touching
# this file — the global block and the @fromcf matcher must stay in sync).
{
  servers {
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    client_ip_headers CF-Connecting-IP
  }
}

swpuacm.xyz, www.swpuacm.xyz {
  encode zstd gzip

  # Security headers, split by framing policy: the in-place auth modal embeds
  # the branded /reg page in a same-origin iframe, so /reg alone uses
  # SAMEORIGIN / frame-ancestors 'self' while everything else stays DENY.
  # (Two disjoint matchers instead of an override: header blocks adapt in a
  # fixed order and a later override line cannot beat the catch-all block.)
  @regpage path /reg
  header @regpage {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    X-Frame-Options "SAMEORIGIN"
    Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  }
  @notreg not path /reg
  header @notreg {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    X-Frame-Options "DENY"
    Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  }

  # SWPU ACM landing page as site front door (revert: delete this line)
  rewrite / /home.html

  # Serve the branded /reg page in place at the native auth URLs — rewrite, no
  # 302 bounce (revert: remove these lines). Bare GET only: POST /login (form
  # submit) and /login?... (two-step flows) pass through untouched. The rewrite
  # target's ?tab=pwd reaches the regcode plugin as handler args, which boots
  # the password tab even though the browser URL keeps no query.
  @barelogin {
    method GET
    path /login
    expression {http.request.uri.query} == ''
  }
  rewrite @barelogin /reg?tab=pwd

  # Same for registration: bare GET /register serves the branded page at
  # /register itself; POST /register (native flow step 1) and
  # /register/<token> pages pass through.
  @bareregister {
    method GET
    path /register
    expression {http.request.uri.query} == ''
  }
  rewrite @bareregister /reg

  # SWPU ACM custom static files (UI-rebuild-proof dir; revert: remove this handle)
  @custom {
    path /home.html /favicon.png /logo.png /favicon-16x16.png /favicon-32x32.png /apple-touch-icon-180x180.png /android-chrome-192x192.png /swpu-display.woff2 /swpu-mono.woff2 /og-cover.png /qq-training-group.png
  }
  handle @custom {
    root * /root/.hydro/custom
    # This handle runs after the rewrite, so both / and /home.html are covered.
    header /home.html Cache-Control "no-cache" {
      match status 2xx
    }
    @customAssets not path /home.html
    # Fixed filenames can change between deployments; avoid a week of stale assets.
    header @customAssets Cache-Control "public, max-age=3600" {
      match status 2xx
    }
    file_server
  }

  log {
    output file /data/access.log {
      roll_size 1gb
      roll_keep_for 72h
    }
    format json
  }
  # Handle static files directly, for better performance.
  root * /root/.hydro/static
  @static {
    file {
      try_files {path}
    }
  }
  handle @static {
    # Cache policy applies only to existing public static files and successful responses.
    @cacheable {
      path *.woff2 *.png *.chunk.js *.worker.js *.css *.svg *.ico /hydro-*.js
      not path /theme-*
    }
    header @cacheable Cache-Control "public, max-age=604800" {
      match status 2xx
    }
    header /theme-*.css Cache-Control "max-age=600" {
      match status 2xx
    }
    file_server
  }

  # Hide the judge service account profile from everyone (revert: remove this handle)
  @hidejudge path /user/3
  handle @hidejudge {
    respond 404
  }

  # Real-IP ingress policy, two mutually exclusive paths — a client can never
  # inject its own X-Forwarded-For into either (Caddy keeps-and-appends the
  # incoming XFF chain for trusted peers, so trusting it via client_ip_headers
  # alone would let a spoofed first element through Cloudflare; deployment.md §6).
  @fromcf remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
  handle @fromcf {
    # CF overwrites any client-supplied CF-Connecting-IP with the real visitor
    # IP, so pinning XFF to it is safe; a CF connection without the header
    # degrades XFF to empty (Hydro falls back to the CF edge IP).
    reverse_proxy http://127.0.0.1:8888 {
      header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
    }
  }
  handle {
    # Dynamic downloads (including /resource/*) retain Hydro's own cache policy.
    # Direct ingress: trust only the connection peer — forged CF-Connecting-IP
    # / XFF from open-internet clients are not forwarded.
    reverse_proxy http://127.0.0.1:8888 {
      header_up X-Forwarded-For {remote_host}
    }
  }
}

