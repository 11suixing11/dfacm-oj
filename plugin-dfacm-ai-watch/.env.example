# Public example only. Store real settings in a private .env or service config.
# The addon reads process.env; it does not load .env files automatically.
DFACM_AI_WATCH_ENABLED=1
DFACM_AI_WATCH_DOMAINS=system
DFACM_AI_WATCH_SCOPE=contests
DFACM_AI_WATCH_CONTESTS=
DFACM_AI_WATCH_RETENTION_DAYS=30
DFACM_AI_WATCH_INTERVAL_MS=2000
DFACM_AI_WATCH_BATCH_SIZE=100
